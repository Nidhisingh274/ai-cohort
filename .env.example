# Template only - this file always keeps placeholder values.
# Anyone setting up this project fresh copies it to .env and puts their
# own real key there. .env is gitignored and must never be committed.

# Groq API key - get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Backend URL used by the Streamlit frontend.
# Leave unset for local runs (defaults to http://127.0.0.1:8000/chat).
# docker-compose sets this to http://backend:8000/chat automatically.
# BACKEND_URL=http://backend:8000/chat